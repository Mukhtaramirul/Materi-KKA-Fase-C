---
layout: base.njk
---
{% set total = collections.bab.length %}
{% set potong = content | potongSlide %}
{% set sebelumnya = collections.bab | cariBab(bab - 1) %}
{% set berikutnya = collections.bab | cariBab(bab + 1) %}
<div class="kelas" data-bab-sekarang="{{ bab }}">

  <header class="bar-kelas">
    <a class="tombol-ikon" href="/#silabus" aria-label="Kembali ke halaman kelas"><span class="ikon">arrow_back</span></a>
    <div class="bar-kelas-judul">
      <span class="bar-kelas-kecil">Materi KKA Fase C · Bab {{ bab }} dari {{ total }}</span>
      <span class="bar-kelas-besar">{{ judul }}</span>
    </div>
    <button class="tombol-ikon tombol-daftar" type="button" data-buka-daftar aria-label="Buka daftar modul" aria-controls="daftar-modul"><span class="ikon">toc</span></button>
    <div class="bar-progres" aria-hidden="true"><span data-progres-slide></span></div>
  </header>

  <aside class="daftar-modul" id="daftar-modul" aria-label="Daftar modul">
    <div class="daftar-modul-kepala">
      <div>
        <p class="daftar-modul-judul">Daftar Modul</p>
        <p class="daftar-modul-progres" data-progres-teks>0 dari {{ total }} bab selesai</p>
      </div>
      <button class="tombol-ikon tutup-daftar" type="button" data-tutup-daftar aria-label="Tutup daftar modul"><span class="ikon">close</span></button>
    </div>
    <ol class="modul-list">
      {% for item in collections.bab %}
      {% set aktif = item.data.bab == bab %}
      <li class="modul{% if aktif %} modul-aktif{% endif %}">
        <a class="modul-link" href="{{ item.url }}"{% if aktif %} aria-current="page"{% endif %}>
          <span class="status-ikon" data-status-bab="{{ item.data.bab }}"></span>
          <span><small>Bab {{ item.data.bab }}</small>{{ item.data.judul }}</span>
        </a>
        {% if aktif %}
        <ol class="sub-list">
          <li><a href="#pengantar" data-ke-slide="pengantar">Pengantar</a></li>
          {% for s in potong.bagian %}
          <li><a href="#{{ s.id }}" data-ke-slide="{{ s.id }}">{{ s.teks | safe }}</a></li>
          {% endfor %}
          <li><a href="#selesai" data-ke-slide="selesai">Selesai</a></li>
        </ol>
        {% endif %}
      </li>
      {% endfor %}
      <li class="modul">
        <a class="modul-link" href="/latihan/">
          <span class="ikon status-latihan">edit_note</span>
          <span><small>Evaluasi</small>Latihan Soal</span>
        </a>
      </li>
    </ol>
  </aside>
  <div class="latar-daftar" data-tutup-daftar></div>

  <main class="area-belajar">
    <article class="materi isi">

      <section class="slide slide-pembuka" id="pengantar">
        <header class="materi-kepala">
          <p class="materi-meta">
            <span class="chip bab-{{ bab }}">Bab {{ bab }}</span>
            <span class="meta-item"><span class="ikon">schedule</span>± {{ content | menitBaca }} menit baca</span>
            <span class="meta-item"><span class="ikon">toc</span>{{ potong.bagian.length }} bagian</span>
          </p>
          <h1 class="headline">{{ judul }}</h1>
          {% if subjudul %}<p class="subjudul">{{ subjudul }}</p>{% endif %}
        </header>

        {% if tujuan %}
        <div class="kartu-info kartu-tujuan">
          <span class="ikon">flag</span>
          <div>
            <p class="kartu-info-judul">Yang akan kamu pelajari</p>
            <p>{{ tujuan }}</p>
          </div>
        </div>
        {% endif %}

        {{ potong.pembuka | safe }}

        <details class="isi-bab">
          <summary class="isi-bab-judul">Lihat isi bab ({{ potong.bagian.length }} bagian)<span class="ikon">expand_more</span></summary>
          <ol>
            {% for s in potong.bagian %}
            <li><a href="#{{ s.id }}" data-ke-slide="{{ s.id }}">{{ s.teks | safe }}</a></li>
            {% endfor %}
          </ol>
        </details>
      </section>

      {% for s in potong.slide %}
      <section class="slide" id="{{ s.id }}" data-induk="{{ s.induk }}">
        {% if s.lanjutan %}<p class="slide-induk">{{ s.indukTeks | safe }}</p>{% endif %}
        {{ s.html | safe }}
      </section>
      {% endfor %}

      <section class="slide" id="selesai">
        <div class="selesai-bab">
          <span class="ikon">check_circle</span>
          <h2>Hebat, Bab {{ bab }} selesai!</h2>
          <p>Bab ini sudah ditandai selesai di progres belajarmu. Lanjutkan ke bab berikutnya atau kerjakan latihan soal.</p>
          <div class="grup-tombol">
            {% if berikutnya %}
            <a class="tombol tombol-filled" href="{{ berikutnya.url }}">Lanjut ke Bab {{ berikutnya.data.bab }}<span class="ikon">arrow_forward</span></a>
            {% endif %}
            <a class="tombol {% if berikutnya %}tombol-tonal{% else %}tombol-filled{% endif %}" href="/latihan/"><span class="ikon">edit_note</span>Latihan soal</a>
            <a class="tombol tombol-outlined" href="{{ site.pdf }}" download><span class="ikon">download</span>Unduh PDF</a>
          </div>
          <button class="tombol tombol-teks batal-selesai" type="button" data-tandai-selesai><span class="ikon">check_circle</span><span data-teks-tandai>Sudah selesai</span></button>
        </div>
        <footer class="kaki">Materi KKA Fase C · Koding dan Kecerdasan Artifisial untuk Kelas 5 dan 6</footer>
      </section>

    </article>
  </main>

  <nav class="bar-bawah" aria-label="Pindah slide">
    <a class="tombol tombol-teks" href="{{ sebelumnya.url if sebelumnya else '/#silabus' }}" data-tombol-mundur>
      <span class="ikon">arrow_back</span><span data-label-mundur>Sebelumnya</span>
    </a>
    <span class="penghitung-slide" data-penghitung aria-live="polite"></span>
    <a class="tombol tombol-filled" href="{{ berikutnya.url if berikutnya else '/latihan/' }}" data-tombol-maju>
      <span data-label-maju>Selanjutnya</span><span class="ikon">arrow_forward</span>
    </a>
  </nav>
</div>
